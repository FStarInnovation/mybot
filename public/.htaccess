# Правильные MIME-типы для SvelteKit ассетов
AddType application/javascript .js
AddType text/css .css
AddType application/manifest+json .webmanifest

# Предотвращение кеширования для критических маршрутов
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
  </FilesMatch>
</IfModule>

# Fallback для SPA маршрутов
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Прямой маршрут для /chat с обходом любых Service Worker
  RewriteRule ^chat/?$ /index.html [L,NC]
  
  # Поддержка подпутей /chat/...
  RewriteRule ^chat/(.*)$ /index.html [L,NC]
  
  # Если запрос не к существующему файлу/директории
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Для всех остальных маршрутов
  RewriteRule ^.*$ /index.html [L]
</IfModule>