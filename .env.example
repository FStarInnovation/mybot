APP_NAME=Laravel
# Application
APP_NAME="Farmabot"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app-url.com
APP_TIMEZONE=UTC

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (Neon PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=your-neon-host
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=your-neon-password
DB_SSLMODE=require

# Redis (Upstash)
REDIS_CLIENT=phpredis
REDIS_URL=your-upstash-redis-url
REDIS_HOST=your-upstash-host
REDIS_PASSWORD=your-upstash-password
REDIS_PORT=12345
REDIS_SCHEME=tls
REDIS_READ_TIMEOUT=15
REDIS_TIMEOUT=10
REDIS_KEEPALIVE=60
REDIS_SSL_VERIFY_PEER=true
REDIS_SSL_VERIFY_PEER_NAME=true

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Cache
CACHE_DRIVER=redis

# Queue
QUEUE_CONNECTION=redis

# Memory System
SHORT_TERM_TTL=604800  # 7 days in seconds
LONG_TERM_SIMILARITY_THRESHOLD=0.7
LONG_TERM_MAX_RESULTS=3

# LLM Gateway
LLM_API_URL=https://your-runpod-endpoint.com/chat
LLM_MODEL=llama3
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=512

# Embeddings Service
EMBEDDINGS_API_URL=https://your-runpod-endpoint.com/embedding
EMBEDDINGS_MODEL=jina-embeddings-v2-base-en
EMBEDDINGS_DIMENSION=768

# Security
APP_DEBUG=false
APP_ENV=production
SANCTUM_STATEFUL_DOMAINS=your-app-url.com
SESSION_DOMAIN=.your-app-url.com

# Laravel Telescope
TELESCOPE_ENABLED=true

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886

# RunPod Gateway for WhatsApp
RUNPOD_GATEWAY_URL=https://your-runpod-endpoint.proxy.runpod.net/chat
