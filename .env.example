APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Upstash Redis Configuration
REDIS_CLIENT="phpredis"
REDIS_URL=""
REDIS_HOST="cautious-prawn-12345.upstash.io"
REDIS_PASSWORD="<YOUR_UPSTASH_REDIS_REST_TOKEN>"
REDIS_PORT=6379
REDIS_SCHEME=tls
REDIS_READ_TIMEOUT=10
REDIS_TIMEOUT=5

# Chat history TTL (optional override)
CHAT_HISTORY_TTL=86400

# API Keys and External Services
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# Neon
NEON_DATABASE_URL="postgres://user:password@ep-warm-sun-123.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Laravel Telescope
TELESCOPE_ENABLED=true
